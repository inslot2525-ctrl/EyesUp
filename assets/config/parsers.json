{
  "version": 1,
  "_comment": "Seed patterns. Group 1 of each regex is the value. Patterns are tried in order; first match wins. Tune this file directly on the device at /sdcard/Pillion/config/parsers.json and press Reload config in Settings - no rebuild needed. See docs/NOTIFICATION_CORPUS.md for the payloads these must handle.",

  "rejectPatterns": [
    "(?i)you\\s+earned",
    "(?i)weekly\\s+(summary|report)",
    "(?i)payout\\s+credited",
    "(?i)your\\s+(week|day)\\s+on",
    "(?i)incentive\\s+unlocked",
    "(?i)rating",
    "(?i)referral",
    "(?i)login|otp"
  ],
  "_rejectComment": "If any of these match, the notification is not an offer. See corpus X2.",

  "requireDistanceWithPayout": true,
  "_requireComment": "An offer must have BOTH a payout and a distance. Prevents parsing an earnings summary as a huge ride.",

  "shared": {
    "payoutTotal": [
      "(?:₹|Rs\\.?\\s?)\\s*([0-9][0-9,]{1,6}(?:\\.[0-9]{1,2})?)\\s*(?=total)",
      "([0-9][0-9,]{1,6}(?:\\.[0-9]{1,2})?)\\s*(?:₹|Rs\\.?)\\s*total"
    ],
    "payout": [
      "(?:₹|Rs\\.?\\s?)\\s*([0-9][0-9,]{1,6}(?:\\.[0-9]{1,2})?)",
      "(?i)earn\\s*(?:₹|Rs\\.?\\s?)?\\s*([0-9][0-9,]{1,6}(?:\\.[0-9]{1,2})?)"
    ],
    "tripKm": [
      "(?i)(?:drop|trip|ride|total|for)\\D{0,12}([0-9]+(?:\\.[0-9]{1,2})?)\\s*k?ms?\\b",
      "(?i)([0-9]+(?:\\.[0-9]{1,2})?)\\s*k?ms?\\s*(?:trip|ride|total|journey)",
      "(?i)([0-9]+(?:\\.[0-9]{1,2})?)\\s*k?ms?\\b"
    ],
    "pickupKm": [
      "(?i)([0-9]+(?:\\.[0-9]{1,2})?)\\s*k?ms?\\s*(?:away|to\\s*pickup|to\\s*reach|to\\s*restaurant|to\\s*store)",
      "(?i)pickup\\s*([0-9]+(?:\\.[0-9]{1,2})?)\\s*k?ms?\\s*(?:away)?"
    ],
    "etaMin": [
      "(?i)([0-9]{1,3})\\s*(?:min|mins|minutes)\\b"
    ],
    "surge": [
      "(?i)([0-9]\\.[0-9])\\s*x\\b",
      "(?i)([0-9]\\.[0-9])x\\s*surge"
    ],
    "pickupText": [
      "(?i)(?:pickup|from)\\s*:?\\s*([A-Za-z][A-Za-z0-9 .'-]{2,30}?)\\s*(?:·|→|->|,|$)"
    ],
    "dropText": [
      "(?i)(?:drop|to)\\s*:?\\s*([A-Za-z][A-Za-z0-9 .'-]{2,30}?)\\s*(?:·|,|$)",
      "→\\s*([A-Za-z][A-Za-z0-9 .'-]{2,30}?)\\s*(?:·|,|$)"
    ]
  },
  "_sharedComment": "Field lookup order in RegexParser: try the app-specific list first, then fall through to shared. payoutTotal is ALWAYS tried before payout (see corpus S3, where a base fare and a bonus both appear and the total is what matters).",

  "apps": {
    "UBER": {
      "channelId": "sim_uber",
      "packageName": "com.ubercab.driver",
      "kind": "RIDE",
      "ttlSeconds": 25,
      "patterns": {}
    },
    "RAPIDO": {
      "channelId": "sim_rapido",
      "packageName": "com.rapido.rider",
      "kind": "RIDE",
      "ttlSeconds": 20,
      "patterns": {
        "pickupKm": ["(?i)([0-9]+(?:\\.[0-9]{1,2})?)\\s*k?ms?\\s*to\\s*pickup"]
      }
    },
    "SWIGGY": {
      "channelId": "sim_swiggy",
      "packageName": "in.swiggy.deliveryapp",
      "kind": "FOOD",
      "ttlSeconds": 45,
      "patterns": {}
    },
    "ZOMATO": {
      "channelId": "sim_zomato",
      "packageName": "com.application.zomato.rider",
      "kind": "FOOD",
      "ttlSeconds": 45,
      "patterns": {}
    },
    "PORTER": {
      "channelId": "sim_porter",
      "packageName": "com.theporter.android.driverapp",
      "kind": "PARCEL",
      "ttlSeconds": 30,
      "patterns": {}
    }
  },

  "confidenceWeights": {
    "payout": 0.40,
    "tripKm": 0.30,
    "pickupKm": 0.15,
    "etaMinutes": 0.10,
    "kind": 0.05
  },
  "tierReliability": {
    "REGEX": 1.0,
    "ENTITY": 0.9,
    "LLM": 0.8
  },
  "cascadeThresholds": {
    "acceptAfterRegex": 0.75,
    "acceptAfterEntity": 0.60,
    "llmTimeoutMs": 3000
  },
  "dedupeWindowMs": 3000
}
